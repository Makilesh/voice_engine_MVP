# .env.example - Environment Variables Template

# ============================================================================
# LLM API Keys (Priority: OpenAI → Gemini → Groq → Ollama)
# ============================================================================
# At least ONE LLM API key OR Ollama is required
# System will automatically fallback to next available provider

# Primary LLM Provider (Recommended)
OPENAI_API_KEY=your_openai_api_key_here

# Fallback LLM Provider (Optional but Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# Second Fallback LLM Provider (Optional)
GROQ_API_KEY=your_groq_api_key_here

# Third Fallback - Local Ollama (Optional, NO API KEY needed)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# TTS API Keys
# ============================================================================
# REQUIRED for Cartesia AI ultra-low latency TTS (40-90ms)
CARTESIA_API_KEY=your_cartesia_api_key_here

# TTS Configuration
USE_CARTESIA_TTS=true

# ============================================================================
# Optional Application Settings
# ============================================================================
# Debug mode (enables verbose logging)
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# How to Get API Keys
# ============================================================================
# 
# OpenAI: https://platform.openai.com/api-keys
# Gemini: https://makersuite.google.com/app/apikey
# Groq: https://console.groq.com/keys
# Cartesia: https://play.cartesia.ai/console
#
# Ollama (Local):
# 1. Install: https://ollama.ai/download
# 2. Pull model: ollama pull llama3.1:latest
# 3. Runs locally at http://localhost:11434 (no API key needed)
#
# ============================================================================

# ============================================================================
# Configuration Notes
# ============================================================================
#
# LLM Fallback Chain:
# OpenAI → Gemini → Groq → Ollama (local) → error message
# Each provider gets 3 retry attempts with exponential backoff
#
# Ollama Benefits:
# - FREE (runs locally, no API costs)
# - Works offline
# - No rate limits
# - Privacy (data stays on your machine)
# - Slower than cloud APIs but reliable fallback
#
# TTS Fallback:
# If Cartesia fails → falls back to SystemEngine (local TTS)
#
# Memory Management:
# - Audio queue: 50-200 elements (dynamic)
# - Memory warning: 500 MB
# - Memory critical: 1000 MB
# - Automatic queue size adjustment
#
# Error Recovery:
# - Max retries per provider: 3
# - Initial retry delay: 1 second
# - Max retry delay: 10 seconds
# - Exponential backoff: 2x per retry
#
# ============================================================================
